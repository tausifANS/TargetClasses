# Dependencies
node_modules/

# Env / secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/
*.tsbuildinfo

# Server runtime — uploads ARE tracked (see below): Vercel's filesystem is
# read-only, so admin-uploaded photos only survive at all if they're bundled
# at deploy time. New uploads after deploying still won't persist — see
# server/src/utils/imageStorage.js.

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings (machine-specific permissions, not for the repo)
.claude/settings.local.json

# Raw personal photo/video uploads at the project root — already archived in
# assets/originals/, kept out of git to avoid duplicating large binaries.
/*.jpeg
/*.jpg
/*.png
/*.mp4
