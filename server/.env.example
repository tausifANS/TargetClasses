# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets backend — see database/google-apps-script/Code.gs for setup steps.
# GOOGLE_SHEETS_API_SECRET must match the API_SECRET constant in that script.
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_API_SECRET=

# Admin Portal — single account. ADMIN_PASSWORD_HASH is a bcrypt hash, generate with:
# node -e "require('bcryptjs').hash('yourPassword', 10).then(console.log)"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Institute contact info
INSTITUTE_NAME=Target Classes
INSTITUTE_PHONE=
INSTITUTE_WHATSAPP=
INSTITUTE_EMAIL=
INSTITUTE_ADDRESS=
INSTITUTE_YOUTUBE=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Target Classes" <no-reply@example.com>
